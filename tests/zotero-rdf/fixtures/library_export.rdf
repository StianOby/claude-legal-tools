    <bib:Document rdf:about="#item_3">
        <z:itemType>case</z:itemType>
        <dcterms:isPartOf>
            <bib:CourtReporter>
                <prism:number>Sak nr. 55/1999</prism:number>
                <dc:title>Rt.</dc:title>
