# Shell scripts must keep LF even in a Windows checkout (bash chokes on CR).
*.sh text eol=lf
# Shared files and their copies inside plugins must be byte-identical on
# every platform (.github/scripts/check-shared.py compares bytes).
shared/** text eol=lf
plugins/*/skills/*/local-route.md text eol=lf
# Browser helpers are loaded from GitHub and checked by sha256 against the
# synced copy (shared/browser-loader/load.sh); keep the bytes identical.
plugins/*/skills/*/scripts/browser/*.js text eol=lf
